# 依赖
node_modules/

# 测试（不随公开仓库发布）
tests/

# 运行时生成的数据（会话 JSONL、事件历史、密码、工作区文件）
data/
workspace/

# portable ffmpeg（~90MB 二进制，不入库；tools/ffmpeg/README.md 说明获取方式）
tools/

# 本地真实配置（含密码等敏感字段；只提交 config.example.json 模板）
config.json
.env
.env.*
*.local

# 本地调试配置
debug.config.json

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db
